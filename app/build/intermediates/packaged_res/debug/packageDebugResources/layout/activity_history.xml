    <TextView android:id="@+id/tvEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chua co buoi tap nao" android:gravity="center" android:textSize="14sp" android:textColor="#999" android:layout_marginTop="40dp" android:visibility="gone" />
