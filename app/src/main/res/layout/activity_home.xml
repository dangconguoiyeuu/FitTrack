<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F5F5F5">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="@android:color/white">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:id="@+id/tvWelcome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Xin chao!" android:textSize="20sp" android:textStyle="bold" android:textColor="#000" />
                <TextView android:id="@+id/tvBmi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:layout_marginTop="6dp" />
                <TextView android:id="@+id/tvSuggestion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#666" android:layout_marginTop="2dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bai tap" android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="10dp" />
        <Button android:id="@+id/btnRunning" android:layout_width="match_parent" android:layout_height="52dp" android:text="Chay bo / Di bo" android:backgroundTint="#000" android:textColor="@android:color/white" android:layout_marginBottom="8dp" />
        <Button android:id="@+id/btnPushUp" android:layout_width="match_parent" android:layout_height="52dp" android:text="Chong day" android:backgroundTint="#000" android:textColor="@android:color/white" android:layout_marginBottom="8dp" />
        <Button android:id="@+id/btnSitUp" android:layout_width="match_parent" android:layout_height="52dp" android:text="Gap bung" android:backgroundTint="#000" android:textColor="@android:color/white" android:layout_marginBottom="16dp" />
        <Button android:id="@+id/btnHistory" android:layout_width="match_parent" android:layout_height="48dp" android:text="Lich su" android:textColor="#000" android:layout_marginBottom="8dp" style="?android:attr/buttonBarButtonStyle" />
        <Button android:id="@+id/btnProfile" android:layout_width="match_parent" android:layout_height="48dp" android:text="Ho so ca nhan" android:textColor="#000" android:layout_marginBottom="8dp" style="?android:attr/buttonBarButtonStyle" />
        <Button android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="48dp" android:text="Dang xuat" android:textColor="#999" style="?android:attr/buttonBarButtonStyle" />
    </LinearLayout>
</ScrollView>
